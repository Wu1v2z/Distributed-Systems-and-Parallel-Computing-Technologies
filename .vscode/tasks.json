{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "ЛР1: зібрати",
      "type": "process",
      "command": "dotnet",
      "args": [
        "build",
        "${workspaceFolder}/lab1/Lab1.csproj"
      ],
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "problemMatcher": "$msCompile"
    },
    {
      "label": "ЛР1: запустити",
      "type": "process",
      "command": "dotnet",
      "args": [
        "run",
        "--project",
        "${workspaceFolder}/lab1/Lab1.csproj"
      ],
      "group": "test",
      "problemMatcher": "$msCompile"
    }
  ]
}
