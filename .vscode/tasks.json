{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "ЛР1: зібрати",
      "type": "process",
      "command": "dotnet",
      "args": [
        "build",
        "${workspaceFolder}/lab1/Lab1.csproj"
      ],
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "problemMatcher": "$msCompile"
    },
    {
      "label": "ЛР1: запустити",
      "type": "process",
      "command": "dotnet",
      "args": [
        "run",
        "--project",
        "${workspaceFolder}/lab1/Lab1.csproj"
      ],
      "group": "test",
      "problemMatcher": "$msCompile"
    },
    {
      "label": "ЛР2: зібрати",
      "type": "process",
      "command": "dotnet",
      "args": [
        "build",
        "${workspaceFolder}/lab2/Lab2.csproj"
      ],
      "group": "build",
      "problemMatcher": "$msCompile"
    },
    {
      "label": "ЛР2: запустити",
      "type": "process",
      "command": "dotnet",
      "args": [
        "run",
        "--project",
        "${workspaceFolder}/lab2/Lab2.csproj"
      ],
      "group": "test",
      "problemMatcher": "$msCompile"
    },
    {
      "label": "ЛР3: зібрати",
      "type": "process",
      "command": "dotnet",
      "args": [
        "build",
        "${workspaceFolder}/lab3/Lab3.csproj",
        "-c",
        "Release"
      ],
      "group": "build",
      "problemMatcher": "$msCompile"
    },
    {
      "label": "ЛР3: запустити експеримент",
      "type": "process",
      "command": "dotnet",
      "args": [
        "run",
        "-c",
        "Release",
        "--no-build",
        "--project",
        "${workspaceFolder}/lab3/Lab3.csproj"
      ],
      "dependsOn": "ЛР3: зібрати",
      "group": "test",
      "problemMatcher": "$msCompile"
    },
    {
      "label": "ЛР4: зібрати",
      "type": "process",
      "command": "dotnet",
      "args": [
        "build",
        "${workspaceFolder}/lab4/Lab4.csproj",
        "-c",
        "Release"
      ],
      "group": "build",
      "problemMatcher": "$msCompile"
    },
    {
      "label": "ЛР4: знайти L1",
      "type": "process",
      "command": "dotnet",
      "args": [
        "run",
        "-c",
        "Release",
        "--no-build",
        "--project",
        "${workspaceFolder}/lab4/Lab4.csproj"
      ],
      "dependsOn": "ЛР4: зібрати",
      "group": "test",
      "problemMatcher": "$msCompile"
    },
    {
      "label": "ЛР5: зібрати",
      "type": "process",
      "command": "dotnet",
      "args": [
        "build",
        "${workspaceFolder}/lab5/Lab5.csproj",
        "-c",
        "Release"
      ],
      "group": "build",
      "problemMatcher": "$msCompile"
    },
    {
      "label": "ЛР5: обчислити L2 на цьому вузлі",
      "type": "process",
      "command": "dotnet",
      "args": [
        "run",
        "-c",
        "Release",
        "--no-build",
        "--project",
        "${workspaceFolder}/lab5/Lab5.csproj"
      ],
      "dependsOn": "ЛР5: зібрати",
      "group": "test",
      "problemMatcher": "$msCompile"
    },
    {
      "label": "ЛР5: запустити slave-сервер",
      "type": "process",
      "command": "dotnet",
      "args": [
        "run",
        "-c",
        "Release",
        "--no-build",
        "--project",
        "${workspaceFolder}/lab5/Lab5.csproj",
        "--",
        "--server",
        "--port",
        "5055"
      ],
      "dependsOn": "ЛР5: зібрати",
      "group": "test",
      "problemMatcher": "$msCompile"
    }
  ]
}
