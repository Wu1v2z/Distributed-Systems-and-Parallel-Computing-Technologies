{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "ЛР1: зібрати",
      "type": "process",
      "command": "dotnet",
      "args": [
        "build",
        "${workspaceFolder}/lab1/Lab1.csproj"
      ],
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "problemMatcher": "$msCompile"
    },
    {
      "label": "ЛР1: запустити",
      "type": "process",
      "command": "dotnet",
      "args": [
        "run",
        "--project",
        "${workspaceFolder}/lab1/Lab1.csproj"
      ],
      "group": "test",
      "problemMatcher": "$msCompile"
    },
    {
      "label": "ЛР2: зібрати",
      "type": "process",
      "command": "dotnet",
      "args": [
        "build",
        "${workspaceFolder}/lab2/Lab2.csproj"
      ],
      "group": "build",
      "problemMatcher": "$msCompile"
    },
    {
      "label": "ЛР2: запустити",
      "type": "process",
      "command": "dotnet",
      "args": [
        "run",
        "--project",
        "${workspaceFolder}/lab2/Lab2.csproj"
      ],
      "group": "test",
      "problemMatcher": "$msCompile"
    },
    {
      "label": "ЛР3: зібрати",
      "type": "process",
      "command": "dotnet",
      "args": [
        "build",
        "${workspaceFolder}/lab3/Lab3.csproj",
        "-c",
        "Release"
      ],
      "group": "build",
      "problemMatcher": "$msCompile"
    },
    {
      "label": "ЛР3: запустити експеримент",
      "type": "process",
      "command": "dotnet",
      "args": [
        "run",
        "-c",
        "Release",
        "--no-build",
        "--project",
        "${workspaceFolder}/lab3/Lab3.csproj"
      ],
      "dependsOn": "ЛР3: зібрати",
      "group": "test",
      "problemMatcher": "$msCompile"
    }
  ]
}
